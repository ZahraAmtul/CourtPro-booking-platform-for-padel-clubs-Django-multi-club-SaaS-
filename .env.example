DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.courtpro.pk,courtpro.pk
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.courtpro.pk,https://courtpro.pk
DATABASE_URL=postgres://padel:padel@db:5432/padel
TIME_ZONE=Asia/Karachi
# Set to False only when testing the production image locally over plain http
DJANGO_SECURE_SSL_REDIRECT=True

# Email (leave EMAIL_BACKEND unset to print emails to the console)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Smash Padel <bookings@yourclub.pk>

# Never true in production: the demo gateway marks payments paid without real money
PAYMENTS_DEMO_ENABLED=False
WHATSAPP_API_VERSION=v23.0

# Multi-club platform
PLATFORM_NAME=CourtPro
PLATFORM_DOMAIN=courtpro.pk
PLATFORM_SUPPORT_EMAIL=support@courtpro.pk
PLATFORM_SUPPORT_WHATSAPP=923001234567
PLATFORM_PAYMENT_INSTRUCTIONS=Bank transfer to CourtPro, Meezan Bank, IBAN PK00 MEZN 0000 0000 0000 0000. Send the receipt on WhatsApp.
PLATFORM_DEMO_CLUB=smash
